+    def _partial_transfer_spec(self, model_name: str):
+        """Resolve ``trainer.args.finetune_partial`` for one model.
+
+        Returns ``None`` (mismatched tensors are skipped — the pre-existing
+        behaviour, and what every config without the key gets), ``True`` (every
+        mismatched tensor of this model), or a list of fnmatch patterns matched
+        against the parameter key.
+        """
+        spec = getattr(self, "finetune_partial", None)
+        if spec is None or spec is False:
+            return None
+        if spec is True:
+            return True
+        if isinstance(spec, (list, tuple)):
+            return [str(p) for p in spec]
+        if isinstance(spec, dict):
+            entry = spec.get(model_name)
+            if entry is None or entry is False:
+                return None
+            if entry is True:
+                return True
+            if isinstance(entry, (list, tuple)):
+                return [str(p) for p in entry]
+            raise ValueError(
+                f"finetune_partial[{model_name!r}] must be true/false or a list of "
+                f"parameter-name patterns; got: {entry!r}"
+            )
+        raise ValueError(
+            "finetune_partial must be true/false, a list of parameter-name patterns, "
+            f"or a {{model_name: ...}} dict; got: {spec!r}"
+        )
+
+    @staticmethod
+    def _partial_transfer_selected(spec, key: str) -> bool:
+        if spec is True:
+            return True
+        return any(fnmatch.fnmatchcase(key, pattern) for pattern in spec)
+
+    @staticmethod
+    def _partial_transfer_tensor(src, dst, fill: str):
+        """Build a ``dst``-shaped tensor holding the per-axis overlap of ``src``.
+
+        Every axis is aligned at index 0, which is the correspondence the
+        emission chains actually have: the pretrained PBR VAE's channel 0:3 is
+        the base_color slot that carries emission, and the pretrained decoder's
+        latent axis 0:32 is the emission latent that ``cat([z, z_pbr])`` puts
+        first.
+
+        ``fill`` governs the part of ``dst`` that ``src`` does not cover:
+          "zeros" — the newly-added fan-in/fan-out block starts at exactly 0, so
+                    at step 0 the pretrained interior sees only the feature
+                    distribution it was pretrained on. Gradients still flow into
+                    it immediately (d out/d W = the new input, which is nonzero).
+          "keep"  — leave that block at its random init.
+        Returns ``(tensor, n_copied)``, or ``None`` when the ranks differ and no
+        slice-wise correspondence exists.
+        """
+        if getattr(src, "ndim", None) != getattr(dst, "ndim", None):
+            return None
+        if fill not in ("zeros", "keep"):
+            raise ValueError(f"finetune_partial_fill must be 'zeros' or 'keep'; got: {fill!r}")
+        out = dst.detach().clone()
+        if fill == "zeros":
+            out.zero_()
+        region = tuple(slice(0, min(int(a), int(b))) for a, b in zip(src.shape, dst.shape))
+        out[region] = src[region].to(dtype=out.dtype, device=out.device)
+        n_copied = 1
+        for sl in region:
+            n_copied *= sl.stop
+        return out, n_copied
+

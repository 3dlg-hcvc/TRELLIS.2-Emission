--- a/configs/scvae/emission_vae_pbr2emission_74k_v3.yaml
+++ b/configs/scvae/emission_vae_pbr2emission_74k_v3.yaml
@@ -160,6 +160,31 @@ trainer:
     finetune_ckpt:
       encoder: microsoft/TRELLIS.2-4B/ckpts/tex_enc_next_dc_f16c32_fp16
       decoder: microsoft/TRELLIS.2-4B/ckpts/tex_dec_next_dc_f16c32_fp16
+    # OPT-IN partial transfer for the 4 I/O tensors whose shape differs from the
+    # pretrained PBR VAE. WITHOUT this key they warn-and-skip (basic.py:390-395)
+    # and keep their xavier_uniform init (sparse_unet_vae.py:384-391 encoder,
+    # 489-496 decoder), which is what the 100-step probe measured. Axis 0 of both
+    # sides is the correspondence in every case:
+    #   encoder.input_layer.weight   (64,6)->(64,3)   in-cols 0:3 of the pretrained
+    #     layer are the base_color slot — exactly where the albedo chain packs
+    #     emission (emission_pbr_finetune.py:54-65; layout lightgen_slat.py:219-225)
+    #   decoder.output_layer.weight  (6,64)->(3,64)   out-rows 0:3, same slot
+    #   decoder.output_layer.bias    (6,)  ->(3,)     same slot
+    #   decoder.from_latent.weight   (1024,32)->(1024,64)  in-cols 0:32 are the
+    #     pretrained latent axis = z_emission; cols 32:64 are the NEW z_pbr half
+    #     (emission_vae.py:142 builds cat([z, z_pbr])) and get zero-filled, so at
+    #     step 0 the pretrained decoder interior sees exactly its pretrained input
+    #     distribution while gradients still flow into the z_pbr block.
+    # 33,155 of the 65,923 reinitialized params become pretrained; 32,768 become
+    # zero; 0 stay random.
+    finetune_partial:
+      encoder:
+      - input_layer.weight
+      decoder:
+      - from_latent.weight
+      - output_layer.weight
+      - output_layer.bias
+    finetune_partial_fill: zeros   # "keep" leaves the new z_pbr block at xavier
     # Unchanged: the frozen conditioning path, off the emission path.
     pretrained_pbr_encoder: microsoft/TRELLIS.2-4B/ckpts/tex_enc_next_dc_f16c32_fp16
     i_log: 10
